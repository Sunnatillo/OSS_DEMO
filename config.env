# Site configuration for the k0rdent BYO Metal3 management cluster.
# Source this before running the scripts under k0rdent/.  Values mirror the
# existing BML lab defaults; override per environment.

# --- Management cluster (kind + KCM) ---
KIND_CLUSTER_NAME="metal3-mgmt"
KCM_VERSION="1.11.0"
# Create the kind cluster WITH the provisioning/external L2 networking via
# host-setup/02_configure_host.sh (required for real provisioning; lab only).
# Set false for a plain dev cluster with no bare-metal networking.
SETUP_HOST_NETWORK="true"

# OCI registry that hosts the BYO charts (reachable from the mgmt cluster).
# e.g. 192.168.111.1:5000  (the lab bootstrap registry)
REGISTRY_HOST="192.168.111.1:5000"

# Trim KCM to only the providers Metal3 needs (faster install, lighter cluster).
# When true the installer removes the default cloud providers from Management.
TRIM_PROVIDERS="true"

# --- Metal3 / CAPI provider versions ---
CAPM3_VERSION="v1.13.5"
IPAM_VERSION="v1.13.5"
CAPI_VERSION="v1.13.4"   # match KCM-bundled CAPI for the kubeadm providers

# --- BMO + IRSO release branches (pin to a release line, never 'main') ---
BMO_BRANCH="release-0.13"    # Bare Metal Operator, paired with CAPM3 1.13
IRSO_BRANCH="release-0.10"   # Ironic Standalone Operator, paired with CAPM3 1.13

# --- Provisioning network (Ironic / DHCP) ---
# Interface Ironic binds. Leave EMPTY to auto-discover the kind node's
# PROVISION_CIDR NIC (correct for a kind-based mgmt cluster). Set explicitly
# only when Ironic runs directly on a host NIC.
PROVISION_INTERFACE=""
KEEPALIVED_VIP="172.22.0.2"       # Ironic + DHCP VIP on the provisioning net
DHCP_RANGE_START="172.22.0.10"
DHCP_RANGE_END="172.22.0.100"
PROVISION_CIDR="172.22.0.0/24"
ROUTER_IP="172.22.0.1"
DNS_IP="8.8.8.8"

# --- Target OS image serving (httpd), as in the current BML flow ---
IMAGE_BASE_URL="http://172.22.0.1/images"
IMAGE_OS="CENTOS_10"
K8S_VERSION="v1.36.2"
# Full URL to the node OS qcow2. Empty => default artifactory path from IMAGE_OS+K8S_VERSION.
NODE_IMAGE_URL="https://idknxc8t3pjc.objectstorage.eu-paris-1.oci.customer-oci.com/p/TuPCYj51maWT0cdJ9iXHHiihnjaRphQGwp22ub1UvrhrLL1aGvzQVZtRe92c2axb/n/idknxc8t3pjc/b/public-metal3-node-image-bucket/o/CENTOS_10_NODE_IMAGE_K8S_v1.36.2.qcow2"

# --- Ironic deployment ---
IRONIC_NAMESPACE="baremetal-operator-system"
IRSO_IRONIC_VERSION="37.0"

# --- Child cluster (ClusterDeployment) ---
CLUSTER_NAMESPACE="kcm-system"
CLUSTER_NAME="test1"
CONTROLPLANE_VIP="192.168.111.249"   # keepalived VIP == control-plane endpoint
POD_CIDR="192.168.0.0/18"
SERVICE_CIDR="10.96.0.0/12"
EXTERNAL_POOL_GATEWAY="192.168.111.1"
EXTERNAL_POOL_START="192.168.111.100"
EXTERNAL_POOL_END="192.168.111.200"
PROVISIONING_POOL_START="172.22.0.100"
PROVISIONING_POOL_END="172.22.0.200"
SSH_PUBLIC_KEY_FILE="${HOME}/.ssh/id_rsa.pub"
